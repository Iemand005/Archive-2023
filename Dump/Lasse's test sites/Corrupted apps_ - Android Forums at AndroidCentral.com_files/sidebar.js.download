jQuery(function($){initSidebarAds();});function initSidebarStick(){$(document).on('scroll',stickSidebarSections);function stickSidebarSections(event){var $window=$(window);var windowHeight=$window.height();var topHeaderHeight=60;var scrollTopPosition=$window.scrollTop();var headerScrollTopPosition=scrollTopPosition+topHeaderHeight;var scrollBottomPosition=scrollTopPosition+windowHeight;$('.sidebar-section > div').each(function(i,block){var styles={'top':0,'position':'absolute',}
var $block=$(block);var $parent=$block.parent()
var blockHeight=$block.height();var parentHeight=$parent.height();$parent.css('min-height',blockHeight);if(blockHeight!=parentHeight){var parentTopPosition=$parent.offset().top;var parentBottomPosition=parentTopPosition+parentHeight;if((scrollBottomPosition>parentTopPosition)&&(headerScrollTopPosition<parentBottomPosition)){var blockLowestTopPosition=parentBottomPosition-blockHeight;if(headerScrollTopPosition>parentTopPosition&&headerScrollTopPosition<blockLowestTopPosition){styles.top=topHeaderHeight;styles.position='fixed';}else if(headerScrollTopPosition>=blockLowestTopPosition){styles.top=parentHeight-blockHeight;}}else if(parentBottomPosition<headerScrollTopPosition){styles.top=parentHeight-blockHeight;}
$block.css(styles);}});}}
function initSidebarAds(){hideUnusedSlots()
function hideUnusedSlots(){if(typeof(tmntag)!=='undefined'&&typeof(tmntag.cmd)!=='undefined'){tmntag.cmd.push(function(){tmntag.onAdunitRendered(function(adunit){if(adunit.isEmpty&&window.location.search.substring(1).split('&').indexOf('keepblankads')==-1){$('#'+adunit.div).closest('.sidebar-section').hide();}});});}}}