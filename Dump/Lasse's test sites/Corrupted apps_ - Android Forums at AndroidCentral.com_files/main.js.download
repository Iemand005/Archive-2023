$(function(){$('[data-igpost]').appear({once:true,marginY:200}).on('appear',function(){var el=this;var igid=$(el).attr('data-igpost');$.getJSON('https://api.instagram.com/oembed/?url=http://instagr.am/p/'+igid+'/',function(data){$(el).html(data.html);});});$(document).on('click','[data-jscopy]',function(){jscopyId='#'+$(this).attr('data-jscopy');$(jscopyId).select();try{var successful=document.execCommand('copy');var msg=successful?'successful':'unsuccessful';console.log('Copying text command was '+msg);}catch(err){console.log('Oops, unable to copy');}});$(document).on('click','.open_ajax',function(){$.fancybox({href:$(this).attr('href'),type:'ajax',dataType:'html',headers:{'X-fancyBox':true},closeBtn:false,callBackOnShow:function(){$('#fancybox-wrap').hide();$.fancybox.showActivity();}});return false;});$(document).on('click',".fancybox_msg",function(){$.fancybox({href:$(this).attr('href'),wrapCSS:'fpop_msg',minHeight:50,openSpeed:1,closeBtn:false});return false;});$(document).on('click','.vbseo_like_link',function(){var post_currentlikes=$(this).parent('span.lb').find('i.n').html();if(!$(this).hasClass('ownpost')){if(!$(this).hasClass('unlike')){$(this).parent('span').find('i.n').html(+post_currentlikes+ +1);$(this).parent('span').addClass('explode');}else{$(this).parent('span').removeClass('explode');$(this).parent('span').find('i.n').html(+post_currentlikes-+1);}}else{return false;}});$(document).on('click','.poplinks li a',function(){$('.Popsicle').hide();});$('#mona_style_dark_trig').click(function(){$('#site-global-wrap').toggleClass('dark');$.cookie('mona_style_dark',$('#site-global-wrap').hasClass('dark'),{expires:365,path:'/'});return false;});var mona_style_dark=$.cookie('mona_style_dark');$('#mona_style_zoomout').click(function(){$('#site-global-wrap').toggleClass('mona_style_zoomout');if($('#site-global-wrap').hasClass('mona_style_zoomout')){$('meta[name=viewport]').attr('content','width=1024');}else{$('meta[name=viewport]').attr('content','width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no');}
$.cookie('mona_style_zoomout',$('#site-global-wrap').hasClass('mona_style_zoomout'),{expires:365,path:'/'});return false;});$('#usercp_mobilenav').click(function(){$('#usercp_nav').slideToggle();return false;});$('#quick_reply').keyup(function(){var quick_reply_text=$('#cke_contents_vB_Editor_QR_editor textarea').val();if(quick_reply_text){$('#quick_reply').addClass('has_content');}else{$('#quick_reply').removeClass('has_content');}});$(document).on('click','.quickreply',function(){$('#quick_reply').removeClass('has_content');});});