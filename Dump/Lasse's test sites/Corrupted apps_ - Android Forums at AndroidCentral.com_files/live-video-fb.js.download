$(function(){var live_video=$('.live-video-alert');var fbvideo=$('#live-video-alert.fb-video',live_video);var is_live=live_video.hasClass('live-video-alert--is_live');if(!fbvideo.length)return;var player=null;var domain_name='.'+document.domain.replace(/.*\.([^\.]+\.[^\.]+)/g,'$1');var cookie_options={path:'/',domain:domain_name};if(!preinit())return;var events=$('#fb-root').data('ready-events');if(events){$.each(events,function(index,value){get_live_video_object(value);});}
if(!player){if(typeof(FB)==='undefined'){$("#fb-root").bind("facebook:init",function(){FB.Event.subscribe('xfbml.ready',get_live_video_object);});}
else FB.Event.subscribe('xfbml.ready',get_live_video_object);}
$('.js-live-video-alert-close',live_video).click(function(event){if(player)player.pause();live_video.remove();$.cookie('live-video-close','1',cookie_options);event.stopPropagation();});$('.js-live-video-alert-expand',live_video).click(function(event){var expand=$(this);var expanded=live_video.toggleClass('live-video-alert--expand').hasClass('live-video-alert--expand');if(expanded){ga('send','event','Live Video','Expand',get_video_id());}
if(player){if(expanded){}
else player.mute();}
event.stopPropagation();});$(live_video).click(function(){if(!$(this).hasClass('live-video-alert--expand')){$('.js-live-video-alert-expand',live_video).click();}});function preinit(){if(get_video_id()!=$.cookie('live-video-id')){$.cookie('live-video-close','0',cookie_options);$.cookie('live-video-position','0',cookie_options);}
if($.cookie('live-video-close')=='1'){live_video.remove();return false;}
else live_video.addClass('live-video-alert--visible');return true;}
function get_live_video_object(msg){if(msg.type==='video'&&msg.id==='live-video-alert'){player=msg.instance;player.play();player.mute();$('.live-video-alert').addClass('live-video-alert--loaded');player.subscribe('startedPlaying',function(){player.seek(get_seek_position());$.cookie('live-video-id',get_video_id(),cookie_options);setTimeout(track_video_position,5000);});player.subscribe('finishedPlaying',function(){$.cookie('live-video-close','1',cookie_options);});}}
function track_video_position(){var time=player.getCurrentPosition();$.cookie('live-video-position',time,cookie_options);var stop=get_stop_position();if(stop&&time>=stop){player.pause();$.cookie('live-video-close','1',cookie_options);}
if($.cookie('live-video-close')!=='1')setTimeout(track_video_position,5000);}
function get_stop_position(){var stop_time=live_video.data('stop-time');if(stop_time>0)return stop_time;else return false;}
function get_seek_position(){var id=get_video_id();var start_time=live_video.data('start-time');if($.cookie('live-video-id')===id){var position=parseInt($.cookie('live-video-position'));if(position>start_time)return position;else return start_time;}
else{if(start_time>0)return start_time;}
return 0;}
function get_video_id(){return $('#live-video-alert').attr('data-href').match(/\/videos\/(\d+)\//i)[1];}});