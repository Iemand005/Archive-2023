{"font-family":"Roboto","font-weight":700}},"tb":{"Open Sans Light":{"font-family":"Open Sans","font-weight":300},"Open Sans Regular":{"font-family":"Open Sans","font-weight":400},"Open Sans Bold":{"font-family":"Open Sans","font-weight":700},"Roboto-Light":{"font-family":"Roboto","font-weight":300},"Roboto-Regular":{"font-family":"Roboto","font-weight":400},"Roboto-Bold":{"font-family":"Roboto","font-weight":700}},"th":{"PxGrotesk-Light":{"font-family":"PxGrotesk-Light","font-weight":400},"PxGrotesk-Regular":{"font-family":"PxGrotesk-Regular","font-weight":400},"PxGrotesk-Bold":{"font-family":"PxGrotesk-Bold","font-weight":400}},"vr":{"Open Sans Light":{"font-family":"Open Sans","font-weight":300},"Open Sans Regular":{"font-family":"Open Sans","font-weight":400},"Open Sans Bold":{"font-family":"Open Sans","font-weight":700},"Work Sans Extra Light":{"font-family":"Work Sans","font-weight":200},"Work Sans Light":{"font-family":"Work Sans","font-weight":300},"Work Sans Medium":{"font-family":"Work Sans","font-weight":500}},"wp":{"Acumin xLight":{"font-family":"acumin-pro","font-weight":200},"Acumin Light":{"font-family":"acumin-pro","font-weight":300},"Acumin Regular":{"font-family":"acumin-pro","font-weight":400},"Acumin Semibold":{"font-family":"acumin-pro","font-weight":600},"Acumin Bold":{"font-family":"acumin-pro","font-weight":700},"Acumin xBold":{"font-family":"acumin-pro","font-weight":800}}};(function(){var classQueue=[];var totalLoaded=0;var fontDisplaySupported=window.FontFace&&window.FontFace.prototype.hasOwnProperty('display');if(fontDisplaySupported)initImmediate();else{jQuery(function($){initFontLoader();});}
function initFontLoader(){if(typeof(mbn_config)=='undefined'||!(mbn_config.site_abbr in site_font_map))return;if(!fontDisplaySupported&&typeof(FontFaceObserver)!='undefined'){var timer=null;Object.keys(site_font_map[mbn_config.site_abbr]).forEach(function(font){var observer=new FontFaceObserver(site_font_map[mbn_config.site_abbr][font]['font-family'],{weight:site_font_map[mbn_config.site_abbr][font]['font-weight']});observer.load(null,15000).then(function(){totalLoaded++;classQueue.push('font-loaded--'+font.toLowerCase().replace(/\s/g,'-').replace(/[^0-9a-z\-]/g,''));if(timer!=null)clearTimeout(timer);if(totalLoaded==site_font_map[mbn_config.site_abbr].length)processClassQueue();else timer=setTimeout(processClassQueue,300);});});}}
function processClassQueue(){$('html').addClass(classQueue.join(' '));classQueue=[];}
function initImmediate(){Object.keys(site_font_map[mbn_config.site_abbr]).forEach(function(font){classQueue.push('font-loaded--'+font.toLowerCase().replace(/\s/g,'-').replace(/[^0-9a-z\-]/g,''));});processClassQueue();}})();