$(function(){$(document).on('click','.mp-username, .mp-username-oh',function(){$(this).unbind('cluetip');$(this).cluetip('destroy');var platform_site=$(this).attr('data-pid');if(typeof platform_site==='undefined'){platform='vb';if(typeof Drupal!=='undefined')platform='d';platform_site=platform+'_'+mbn_config.site.site;}
var basepath='https://passport.mobilenations.com';if(platform_site.match(/^(vb|d)/))basepath='/passport';$(this).attr('data-url',basepath+'/content/login/passport_server.php?mode=miniprofile&'+
'luid='+$(this).attr('data-luid')+
'&pid='+platform_site+
'&uid='+$(this).attr('data-uid')+
'&mod='+$(this).attr('data-mod'));$(this).cluetip({attribute:'data-url',width:460,showTitle:false,arrows:false,sticky:true,delayedClose:500,mouseOutClose:false,dropShadow:false,clickThrough:false,cluetipClass:'default profile-popup',titleAttribute:'data-title',activation:'click',onShow:function(){$(document).on('click.pp_popup',function(e){var isInClueTip=$(e.target).closest('#cluetip');if(isInClueTip.length===0){$(document).trigger('hideCluetip');$(document).off('.pp_popup');}});$(document).on('touchstart.pp_popup',function(event){event=event.originalEvent;var tgt=event.touches[0]&&event.touches[0].target;var $tgt=$(tgt);if(tgt.nodeName!=='A'&&!$tgt.closest('div.cluetip').length){$(document).trigger('hideCluetip');$(document).off('.pp_popup');}});},ajaxCache:false,ajaxSettings:{dataType:'jsonp',timeout:3000},ajaxProcess:function(data){return data;}}).click();return false;});$(document).on('click','#mp-communities .mp-community-link',function(event){var posts_url=$(this).attr('data-posts-url');var comments_url=$(this).attr('data-comments-url');var thanks_url=$(this).attr('data-thanks-url');var likes_url=$(this).attr('data-likes-url');$(this).siblings('.mp-community-link').removeClass('active');$(this).addClass('active');var mpleft=$('#mp-left');mpleft.find('.mp-forum-posts .count').html($(this).attr('data-posts'));if(posts_url&&$(this).attr('data-posts')>0){mpleft.find('.mp-forum-posts').unbind().addClass('mp-clickable').click(function(){window.open(posts_url);});}else{mpleft.find('.mp-forum-posts').unbind().removeClass('mp-clickable');}
mpleft.find('.mp-comments .count').html($(this).attr('data-comments'));if(comments_url&&$(this).attr('data-comments')>0){mpleft.find('.mp-comments').unbind().addClass('mp-clickable').click(function(){window.open(comments_url);});}else{mpleft.find('.mp-comments').unbind().removeClass('mp-clickable');}
mpleft.find('.mp-likes .count').html($(this).attr('data-likes'));if(likes_url&&$(this).attr('data-likes')>0){mpleft.find('.mp-likes').unbind().addClass('mp-clickable').click(function(){window.open(likes_url);});}else{mpleft.find('.mp-likes').unbind().removeClass('mp-clickable');}
return false;});});