function mbn_reposition_sidebar_blocks(){$('.sidebar').each(function(){var ads=$(this).find('.sidebar-body>.block');var totalAdHeight=0;ads.each(function(){var height=$(this).css('height','').css('margin-bottom','0').height();totalAdHeight+=(height>250)?height:250;});var offset=($(this).height()-totalAdHeight)/(ads.length);if(offset<20)offset=20;if($(window).width()<=800)offset=20;ads.css('margin-bottom',offset+'px');});}
$(mbn_reposition_sidebar_blocks);if(typeof(tmntag)!='undefined'&&typeof(tmntag.onAdunitRendered)!='undefined'){tmntag.onAdunitRendered(function(event){var e=$('#'+event.div);if(e.closest('.sidebar').length){mbn_reposition_sidebar_blocks();}});}