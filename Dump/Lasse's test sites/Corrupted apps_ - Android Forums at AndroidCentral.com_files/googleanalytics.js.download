(function($){VB={};VB.settings={};VB.settings.googleanalytics={trackColorbox:false,trackDownload:true,trackMailto:false,trackOutbound:true,trackDomainMode:1,trackUrlFragments:false,trackDownloadExtensions:"7z|aac|arc|arj|asf|asx|avi|bin|csv|doc(x|m)?|dot(x|m)?|exe|flv|gif|gz|gzip|hqx|jar|jpe?g|js|mp(2|3|4|e?g)|mov(ie)?|msi|msp|pdf|phps|png|ppt(x|m)?|pot(x|m)?|pps(x|m)?|ppam|sld(x|m)?|thmx|qtm?|ra(m|r)?|sea|sit|tar|tgz|torrent|txt|wav|wma|wmv|wpd|xls(x|m|b)?|xlt(x|m)|xlam|xml|z|zip"};VB.googleanalytics={};$(document).ready(function(){$(document.body).bind("mousedown keyup touchstart",function(event){$(event.target).closest("a,area").each(function(){if(VB.googleanalytics.isInternal(this.href)){if($(this).is('.colorbox')&&(VB.settings.googleanalytics.trackColorbox)){}
else if(VB.settings.googleanalytics.trackDownload&&VB.googleanalytics.isDownload(this.href)){ga("send",{"hitType":"event","eventCategory":"Downloads","eventAction":VB.googleanalytics.getDownloadExtension(this.href).toUpperCase(),"eventLabel":VB.googleanalytics.getPageUrl(this.href),"transport":"beacon"});}
else if(VB.googleanalytics.isInternalSpecial(this.href)){ga("send",{"hitType":"pageview","page":VB.googleanalytics.getPageUrl(this.href),"transport":"beacon"});}}
else{if(VB.settings.googleanalytics.trackMailto&&$(this).is("a[href^='mailto:'],area[href^='mailto:']")){ga("send",{"hitType":"event","eventCategory":"Mails","eventAction":"Click","eventLabel":this.href.substring(7),"transport":"beacon"});}
else if(VB.settings.googleanalytics.trackOutbound&&this.href.match(/^\w+:\/\//i)){if(VB.settings.googleanalytics.trackDomainMode!==2||(VB.settings.googleanalytics.trackDomainMode===2&&!VB.googleanalytics.isCrossDomain(this.hostname,VB.settings.googleanalytics.trackCrossDomains))){ga("send",{"hitType":"event","eventCategory":"Outbound links","eventAction":"Click","eventLabel":this.href,"transport":"beacon"});}}}});});if(VB.settings.googleanalytics.trackUrlFragments){window.onhashchange=function(){ga("send",{"hitType":"pageview","page":location.pathname+location.search+location.hash});};}
if(VB.settings.googleanalytics.trackColorbox){$(document).bind("cbox_complete",function(){var href=$.colorbox.element().attr("href");if(href){ga("send",{"hitType":"pageview","page":VB.googleanalytics.getPageUrl(href)});}});}});VB.googleanalytics.isCrossDomain=function(hostname,crossDomains){if(!crossDomains){return false;}
else{return $.inArray(hostname,crossDomains)>-1?true:false;}};VB.googleanalytics.isDownload=function(url){var isDownload=new RegExp("\\.("+VB.settings.googleanalytics.trackDownloadExtensions+")([\?#].*)?$","i");return isDownload.test(url);};VB.googleanalytics.isInternal=function(url){var isInternal=new RegExp("^(https?):\/\/"+window.location.host,"i");return isInternal.test(url);};VB.googleanalytics.isInternalSpecial=function(url){var isInternalSpecial=new RegExp("(\/go\/.*)$","i");return isInternalSpecial.test(url);};VB.googleanalytics.getPageUrl=function(url){var extractInternalUrl=new RegExp("^(https?):\/\/"+window.location.host,"i");return url.replace(extractInternalUrl,'');};VB.googleanalytics.getDownloadExtension=function(url){var extractDownloadextension=new RegExp("\\.("+VB.settings.googleanalytics.trackDownloadExtensions+")([\?#].*)?$","i");var extension=extractDownloadextension.exec(url);return(extension===null)?'':extension[1];};})(jQuery);